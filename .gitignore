# Source-only repository policy:
# ignore every untracked path unless it is explicitly part of the numerical
# implementation, build definition, test suite, or numerical validation.
/*

# Keep the policy itself.
!/.gitignore

# Required project metadata and documentation.
!/README.md
!/PROJECT_DOCUMENTATION.md
!/LICENSE
!/CITATION.cff

# Top-level numerical build and Python implementation.
!/CMakeLists.txt
!/*.py

# CMake modules used to configure the numerical build.
!/cmake/
/cmake/*
!/cmake/*.cmake

# C++ numerical interfaces and implementation.
!/include/
/include/*
!/include/*.hpp
!/include/*.hpp.in

!/src/
/src/*
!/src/CMakeLists.txt
!/src/*.cpp

# Numerical tests and their required configuration fixtures.
!/tests/
/tests/*
!/tests/CMakeLists.txt
!/tests/*.cpp
!/tests/*.py
!/tests/*.cfg

# Machine-readable numerical validation code.
!/validation/
/validation/*
!/validation/*.py
!/validation/README.md

# Required solar-model input; all generated/runtime data remain ignored.
!/data/
/data/*
!/data/model_agss09.dat

!/examples/
/examples/*
!/examples/*.cfg

# Historical transport analysis and current boundary contract.
!/TRANSPORT_REVISION_20260918.md
!/BOUNDARY_1100RSUN_REVISION.md
!/scripts/
/scripts/*
!/scripts/analyze_point.py
!/scripts/analyze_thermal.py
!/scripts/prepare_transport_runs.py
!/scripts/halo_focused_density.py
!/scripts/summarize_transport_scan.py
!/scripts/test_analyze_point.py
